# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.celestiqtech.com

# Set to 1 on staging builds that must never be indexed (robots.txt blocks
# everything and pages get noindex). Vercel previews are blocked automatically.
SITE_NOINDEX=

# Search engines & analytics (all optional; nothing loads while empty).
# Search Console "HTML tag" method: paste only the content="…" value.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools meta tag value (msvalidate.01)
BING_SITE_VERIFICATION=
# Google Tag Manager container, e.g. GTM-XXXXXXX (configure GA4 inside GTM)
NEXT_PUBLIC_GTM_ID=
# Or GA4 on its own, e.g. G-XXXXXXXXXX (ignored when a GTM ID is set)
NEXT_PUBLIC_GA_ID=

# Contact form delivery: email (recommended) or webhook.
#
# Email over SMTP. For Gmail: turn on 2-Step Verification, create an
# App Password at https://myaccount.google.com/apppasswords and paste the
# 16-character code into SMTP_PASS (not your normal Gmail password).
CONTACT_TO_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional sender, defaults to "Celestiq Technologies Website <SMTP_USER>"
CONTACT_FROM_EMAIL=

# Or a webhook: an http(s) endpoint that accepts a JSON POST
# (Zapier/Make, Slack, CRM). Used only when SMTP is not configured.
# With neither set, submissions are logged in development and rejected
# with a clear message in production.
CONTACT_WEBHOOK_URL=
